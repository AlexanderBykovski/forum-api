{
  "info": {
    "name": "Forum API",
    "description": "Forum API: auth, users, categories and posts (Prisma ORM 8). Base URL: http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register alice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/auth/register" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}" }
          }
        },
        {
          "name": "Register bob",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/auth/register" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"secret456\"\n}" }
          }
        },
        {
          "name": "Login alice (save accessToken cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const jar = pm.cookies.get('accessToken');",
                  "pm.test('accessToken cookie present', () => pm.expect(jar).to.not.be.undefined);",
                  "console.log('accessToken:', jar);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/auth/login" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}" }
          }
        },
        {
          "name": "Login bob (save accessToken cookie)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/auth/login" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"secret456\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create category: Новини",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/categories" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Новини\"\n}" }
          }
        },
        {
          "name": "Create category: Обговорення",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/categories" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Обговорення\"\n}" }
          }
        },
        {
          "name": "Get all categories",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/categories" }
          }
        },
        {
          "name": "Get category by id",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/categories/1" }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post 1 by alice (authorId: 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Перший допис\",\n  \"content\": \"Привіт, форуме!\",\n  \"categoryId\": 1,\n  \"authorId\": 1\n}" }
          }
        },
        {
          "name": "Create post 2 by bob (authorId: 2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Другий допис\",\n  \"content\": \"Обговорюємо Prisma 8\",\n  \"categoryId\": 2,\n  \"authorId\": 2\n}" }
          }
        },
        {
          "name": "Create post 3 by alice (authorId: 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Третій допис\",\n  \"categoryId\": 1,\n  \"authorId\": 1\n}" }
          }
        },
        {
          "name": "Get all posts (include category + author)",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/posts" }
          }
        },
        {
          "name": "Get post by id (include category + author)",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/posts/1" }
          }
        },
        {
          "name": "Filter posts by category name",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/posts?category=%D0%9D%D0%BE%D0%B2%D0%B8%D0%BD%D0%B8" }
          }
        },
        {
          "name": "Filter posts by categoryId",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/posts?categoryId=1" }
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "401: wrong password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/auth/login" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrongpass\"\n}" }
          }
        },
        {
          "name": "409: duplicate email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/auth/register" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}" }
          }
        },
        {
          "name": "400: invalid post id",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/posts/abc" }
          }
        },
        {
          "name": "400: invalid authorId in body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"x\",\n  \"categoryId\": 1,\n  \"authorId\": \"abc\"\n}" }
          }
        },
        {
          "name": "400: invalid categoryId in body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"x\",\n  \"categoryId\": \"abc\",\n  \"authorId\": 1\n}" }
          }
        },
        {
          "name": "404: post not found",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/posts/999" }
          }
        },
        {
          "name": "404: category not found",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"x\",\n  \"categoryId\": 999,\n  \"authorId\": 1\n}" }
          }
        },
        {
          "name": "404: author not found",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"x\",\n  \"categoryId\": 1,\n  \"authorId\": 999\n}" }
          }
        },
        {
          "name": "409: duplicate category name",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/categories" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Новини\"\n}" }
          }
        },
        {
          "name": "422: missing title",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"categoryId\": 1,\n  \"authorId\": 1\n}" }
          }
        },
        {
          "name": "422: missing authorId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/posts" },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"x\",\n  \"categoryId\": 1\n}" }
          }
        },
        {
          "name": "422: unknown field",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:8000/categories" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"x\",\n  \"foo\": 1\n}" }
          }
        }
      ]
    }
  ]
}
