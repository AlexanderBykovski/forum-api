// use prisma-8

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String?
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}
